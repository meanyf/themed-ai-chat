POSTGRES_PASSWORD=chat_local
POSTGRES_PORT=5432
# Необязательно: полный DATABASE_URL имеет приоритет над параметрами PostgreSQL.

# Ключ входа для локальной разработки.
ACCESS_KEY=local_chat_key
# Заглушки достаточно для старта. Для ответов модели укажите свой ключ в .env.
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
# SYSTEM_PROMPT по умолчанию задаёт тему кулинарии.
